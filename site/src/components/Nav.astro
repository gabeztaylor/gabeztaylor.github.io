---
const links = [
  { href: '/', label: 'Home' },
  { href: '/Blog', label: 'Blog' },
  { href: '/About', label: 'About' },
];
---

<header class="nav">
  <div class="inner">
    <a class="nameLink" href="/" aria-label="Home">Gabriel Taylor</a>
    <nav class="links" aria-label="Primary">
      {links.map((link) => <a class="link" href={link.href}>{link.label}</a>)}
    </nav>
    <button class="theme" type="button" id="themeToggle" aria-label="Toggle theme">Theme</button>
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const key = "theme";
  const saved = localStorage.getItem(key);
  if (saved === "dark" || saved === "light") root.setAttribute("data-theme", saved);

  document.getElementById("themeToggle")?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    localStorage.setItem(key, next);
    root.setAttribute("data-theme", next);
  });
</script>

<style>
  .nav { margin-bottom: 68px; }
  .inner { display: flex; align-items: center; gap: 14px; }
  .nameLink { margin-right: auto; color: var(--text); font-size: 12px; font-weight: 600; text-decoration: none; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }
  .link, .theme { padding: 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; }
  .link:hover, .theme:hover { color: var(--text); }
  @media (max-width: 520px) {
    .nav { margin-bottom: 48px; }
    .inner { flex-wrap: wrap; }
    .nameLink { width: 100%; }
  }
</style>
