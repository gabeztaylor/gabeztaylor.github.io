---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPageByPermalink } from "../lib/jekyllContent.js";

const page = loadPageByPermalink("/About");
---

<BaseLayout title={page?.title || "About"}>
  <section class="card page aboutGrid">
    <div class="content" set:html={page?.html || "<p>About page not found.</p>"} />
    <figure class="portrait">
      <img src="/assets/bio.jpeg" alt="Gabriel Taylor" loading="lazy" />
      <figcaption>Gabriel Taylor · Chicago, Illinois</figcaption>
    </figure>
  </section>
</BaseLayout>

<style>
  .page { padding: 0; }
  .aboutGrid { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 40px; align-items: start; }
  .portrait { margin: 0; }
  .portrait img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(.15); }
  .portrait figcaption { padding-top: 8px; color: var(--muted); font-size: 11px; }
  .content :global(blockquote) {
    margin: 14px 0;
    padding: 12px 14px;
    border-left: 3px solid color-mix(in oklab, var(--accent) 55%, var(--border));
    background: transparent;
    border-radius: 0;
  }
  @media (max-width: 640px) { .aboutGrid { grid-template-columns: 1fr; } .portrait { max-width: 190px; } }
</style>

